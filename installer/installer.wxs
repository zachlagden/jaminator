<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    Jaminator MSI installer.
    Build: wix build installer/installer.wxs -d Version=X.Y.Z.0 -d SourceDir=<bin/Release/net48> -o build/Jaminator.msi
  -->

  <Package Name="Jaminator"
           Manufacturer="Jam Coding"
           Version="$(var.Version)"
           UpgradeCode="21390A38-5337-4A33-A236-2DA81DC24110"
           Compressed="yes"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="Jaminator — Jam Coding laptop maintenance"
                        Manufacturer="Jam Coding" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs metadata. The Icon Id must end in .ico for Windows
         to render shortcut icons correctly (otherwise treated as exe icon). -->
    <Icon Id="Jaminator.ico" SourceFile="..\src\Jaminator\Jaminator.ico" />
    <Property Id="ARPPRODUCTICON" Value="Jaminator.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/zachlagden/jaminator" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/zachlagden/jaminator" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- ARPNOMODIFY is set by WixUI_Minimal already -->


    <Feature Id="Main" Title="Jaminator" Level="1" Display="expand"
             Description="The Jaminator EXE, dependency, scheduled login task, and Start Menu shortcut.">
      <ComponentGroupRef Id="JaminatorFiles" />
      <ComponentGroupRef Id="JaminatorShortcut" />
      <ComponentGroupRef Id="JaminatorDesktopShortcut" />
    </Feature>

    <!-- Desktop shortcut — installed by default. Override with
         msiexec /i Jaminator.msi DESKTOPSHORTCUT=0  to skip it. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" />

    <!-- Welcome+EULA combined → Install → Progress → Finish.
         WixUI_Minimal renders the EULA RTF on the welcome screen with an
         "I accept" radio that gates the Install button. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="EULA.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Jaminator now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- Standard "launch app on finish" pattern: WixShellExec from the Util
         extension runs in UI context (so it can read WIXUI_EXITDIALOG... props)
         and is wired to the ExitDialog's Finish button via UI Publish. -->
    <Property Id="WixShellExecTarget" Value="[#JaminatorExeFile]" />
    <CustomAction Id="LaunchApplication"
                  DllEntry="WixShellExec"
                  Impersonate="yes"
                  BinaryRef="Wix4UtilCA_X86" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="Jaminator" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationMenuDir" Name="Jaminator" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="JaminatorFiles" Directory="INSTALLDIR">
      <Component>
        <File Id="JaminatorExeFile"
              Source="$(var.SourceDir)\Jaminator.exe"
              KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(var.SourceDir)\Newtonsoft.Json.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="JaminatorDesktopShortcut" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="9B5C4E86-22C9-4A1F-9FC4-B2D5C7AA7C19" Condition="DESKTOPSHORTCUT=&quot;1&quot;">
        <Shortcut Id="JaminatorDesktopShortcut"
                  Name="Jaminator"
                  Description="Jam Coding laptop maintenance"
                  Target="[#JaminatorExeFile]"
                  WorkingDirectory="INSTALLDIR"
                  Icon="Jaminator.ico" />
        <RegistryValue Root="HKMU"
                       Key="Software\Jaminator"
                       Name="desktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="JaminatorShortcut" Directory="ApplicationMenuDir">
      <Component Id="StartMenuShortcut" Guid="4388B597-0CAE-4233-A882-13AD669B0CA7">
        <Shortcut Id="JaminatorStartMenu"
                  Name="Jaminator"
                  Description="Jam Coding laptop maintenance"
                  Target="[#JaminatorExeFile]"
                  WorkingDirectory="INSTALLDIR"
                  Icon="Jaminator.ico" />
        <RemoveFolder Id="RemoveApplicationMenuDir" On="uninstall" />
        <RegistryValue Root="HKMU"
                       Key="Software\Jaminator"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Custom actions: register / unregister the logon scheduled task by
         calling the EXE itself. Deferred so they run with elevated privileges. -->
    <CustomAction Id="RegisterTask"
                  FileRef="JaminatorExeFile"
                  ExeCommand="--register-task"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="UnregisterTask"
                  FileRef="JaminatorExeFile"
                  ExeCommand="--unregister-task"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RegisterTask"
              After="InstallFiles"
              Condition="NOT Installed OR REINSTALL" />
      <Custom Action="UnregisterTask"
              Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
      <!-- LaunchApp custom action (defined above) is sequenced via its own InstallExecuteSequence above -->
    </InstallExecuteSequence>

  </Package>
</Wix>
