<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <AssemblyName>Jaminator-Setup</AssemblyName>
    <RootNamespace>Jaminator.Bootstrap</RootNamespace>
    <Version>1.0.0</Version>
    <Platforms>AnyCPU</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <Company>Jam Coding</Company>
    <Product>Jaminator Setup</Product>
    <AssemblyTitle>Jaminator Setup</AssemblyTitle>
    <Description>Downloads the latest Jaminator MSI from GitHub and runs it.</Description>
    <ApplicationIcon>..\src\Jaminator\Jaminator.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
